// Cloudflare Worker for the blog: serves the build under https://sciscend.com/blog/.
// Static assets only, no Worker code. Deploy: `npm run deploy` (see deploy/README.md).
// Live on the route sciscend.com/blog/* since 2026-11-03 (migration phase 3,
// workspace: operations/cloudflare-workers-migration.md). workers.dev is off.
//
// Why not `"directory": "./dist", "base_path": "/blog"`: on 2026-11-03 Cloudflare
// refused it for this account ("A non-root assets.base_path is not enabled for
// this account. [code: 100343]"). deploy/deploy.sh therefore copies dist/ into
// dist-cf/blog/ and moves _headers to dist-cf/, so the asset paths already carry
// /blog. Once base_path is enabled, switch to directory ./dist + base_path /blog
// and drop the staging step; _headers stays the same (it uses public paths).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sciscend-blog",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "sciscend.com/blog/*", "zone_name": "sciscend.com" }],
  // No Version or Preview URLs: deploys go straight from the laptop, and each
  // would be one more public copy of the site (sciscend operations/cloudflare-workers-review.md).
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cf",
    // trailingSlash 'always' + build.format 'directory': /blog/x -> /blog/x/.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get the nearest 404.html, dist-cf/blog/404.html, with status
    // 404 (nginx: error_page 404 /blog/404.html).
    "not_found_handling": "404-page"
  }
}
