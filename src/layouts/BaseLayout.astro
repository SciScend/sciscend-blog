---
import '../styles/global.css';
import { SITE, BLOG_URL, url, asset } from '../site.config.ts';

interface Props {
  title?: string;
  description?: string;
  /** Share image relative to /public, or an absolute URL. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = /^https?:/.test(image) ? image : new URL(asset(image), Astro.site).href;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131618" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${BLOG_URL}rss.xml`} />
    <link rel="sitemap" href={`${BLOG_URL}sitemap-index.xml`} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url()}>
          <img src={asset('logo-mark.png')} alt="" width="36" height="36" />
          <span>SciScend <span class="sep">/</span> Блог</span>
        </a>
        <nav class="site-nav" aria-label="Навигация на блога">
          <a href={url()} aria-current={path === url() ? 'page' : undefined}>Статии</a>
          <a href={url('tag')} aria-current={path.startsWith(url('tag')) ? 'page' : undefined}>Категории</a>
          <a href={`${BLOG_URL}rss.xml`}>RSS</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} <a href={`${SITE.origin}/`}>SciScend</a> · {SITE.author.name}</span>
        <span><a href={`mailto:${SITE.contact}`}>{SITE.contact}</a> · <a href={`${BLOG_URL}rss.xml`}>RSS</a></span>
      </div>
    </footer>
  </body>
</html>
