# Copy to deploy/deploy.env. deploy.env is gitignored.
# DEPLOY_SSH is an ~/.ssh/config alias, so no credentials live here.

DEPLOY_SSH="bulinfo"
DEPLOY_PORT="22"

# Blog web root — nginx `location ^~ /blog/` with `root /var/www/sciscend.com`.
DEPLOY_PATH="/var/www/sciscend.com/blog"

# Placeholder web root — nginx server `root` for sciscend.com.
PLACEHOLDER_PATH="/var/www/sciscend.com/html"
